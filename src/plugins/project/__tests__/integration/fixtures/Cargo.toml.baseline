[package]
name = "test-app"
version = "1.2.3"
edition = "2021"

[lib]
name = "test_app_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
tauri-build = { version = "2", features = [] }

[dependencies]
tauri = { version = "2.12", features = [] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tauri-plugin-haptics = "^2"
tauri-plugin-store = "^2"

[target.'cfg(target_os = "ios")'.dependencies]
objc2 = "0.6"
